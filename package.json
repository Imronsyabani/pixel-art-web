{
  "name": "cliff-garden",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "predev": "npm run assets:generate",
    "dev": "vite",
    "build": "npm run assets:generate && npm run assets:validate && vite build && npm run budget:check",
    "build:ci": "vite build && npm run budget:check",
    "preview": "vite preview",
    "test": "node --test",
    "budget:check": "node scripts/check-performance-budget.mjs",
    "performance:startup:3g": "node scripts/measure-game-startup-3g.mjs",
    "assets:validate": "node scripts/validate-character-assets.js",
    "assets:generate": "python scripts/generate_character_animations.py"
  },
  "dependencies": {
    "@fontsource-variable/pixelify-sans": "5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "puppeteer-core": "25.16.0",
    "tailwindcss": "^4.1.11",
    "vite": "^7.0.6"
  }
}
